#!/bin/bash

# `systemctl start` on a unit with `After=airplanes-first-run.service`
# would wait for this script to finish before activating that unit —
# which can never happen while the start itself is blocking us. The fix
# is `--no-block` on the enable-arm start: queue the start job and let
# systemd run it after this Type=oneshot script exits. `enable` is
# dropped to a pure symlink (no `--now`) for the same reason; the
# subsequent `start --no-block` performs the activation. Disable does
# not have a corresponding circular dependency (stopping a unit doesn't
# need its After= predecessor inactive), so it keeps the synchronous
# form.
function services-handle() {
    for SERVICE in $2; do
        echo "$1 $SERVICE"
        if [[ $1 == disable ]]; then
            if systemctl is-enabled $SERVICE &>/dev/null; then
                systemctl disable --now $SERVICE
            fi
            if systemctl is-active $SERVICE &>/dev/null; then
                systemctl stop $SERVICE
            fi
        fi
        if [[ $1 == enable ]]; then
            if ! systemctl is-enabled $SERVICE &>/dev/null; then
                systemctl enable $SERVICE
            fi
            if ! systemctl is-active $SERVICE &>/dev/null; then
                systemctl start --no-block $SERVICE
            fi
        fi
    done
}
bash /usr/local/bin/create-uuid.sh
bash /usr/local/bin/fix-config.sh
if [ -f "/boot/airplanes-config.txt" ]; then

    # remove spaces from non-comment lines:
    sed -e '/^#/!s/ //g' /boot/airplanes-config.txt > /run/airplanes-config.txt
    # cater to idiots
    sed -i -e 's/NO/no/g' -e 's/YES/yes/g' /run/airplanes-config.txt
    # only do a write if necessary
    if ! cmp /boot/airplanes-config.txt /run/airplanes-config.txt; then
        mv -f /run/airplanes-config.txt /boot/airplanes-config.txt
    fi

    . /boot/airplanes-config.txt

    # Translate the legacy boot config into the canonical /etc/airplanes/feed.env
    # schema that the feed daemons (airplanes-feed.sh, airplanes-mlat.sh) source
    # at startup. The new daemon wrappers do not read /boot/airplanes-config.txt
    # directly, so without this step legacy-webconfig saves would not propagate
    # to the running services on the next restart. Idempotent (no-op when the
    # legacy values already match feed.env).
    #
    # `--no-restart`: this service is Type=oneshot and the legacy services
    # (airplanes-feed, airplanes-mlat, dump978-fa, airplanes-978) declare
    # After=airplanes-first-run.service, so any systemctl restart issued
    # from inside the script would deadlock against the units waiting for
    # this script to finish. Restart ownership lives with systemd (boot
    # path) or with airplanes-webconfig/helpers/restart-services.sh (save
    # path) — both happen after this script exits.
    #
    # apl-feed is shipped by feed/update.sh and only present after the legacy
    # update bridge has fully run, so gate on command -v — pure-legacy boxes
    # (no bridge yet) skip silently.
    if command -v apl-feed >/dev/null 2>&1; then
        if ! apl-feed import legacy-config --no-restart /boot/airplanes-config.txt; then
            echo "airplanes-first-run: apl-feed import legacy-config failed; feed.env may be stale" >&2
        fi
    fi

    SERVICES_978="dump978-fa airplanes-978 tar1090-978"
    if [ ${DUMP978} == "yes" ]; then
        services-handle enable "$SERVICES_978"
    else
        services-handle disable "$SERVICES_978"
    fi

    if [ ${DUMP1090} == "yes" ] && { [[ -z ${AUTOGAIN} ]] || [[ ${AUTOGAIN} == "yes" ]]; }; then
        services-handle enable autogain1090.timer
    else
        services-handle disable autogain1090.timer
    fi

    # readsb isn't disabled as the main map needs to stay for feeding 978
    SERVICES_MLAT="airplanes-mlat"
    if [ ${DUMP1090} == "yes" ] && [[ $USER != "disable" ]]; then
        services-handle enable "$SERVICES_MLAT"
    else
        services-handle disable "$SERVICES_MLAT"
    fi

    SERVICES_GRAPHS="graphs1090 collectd"
    if [[ "${GRAPHS1090}" != "no" ]]; then
        services-handle enable "$SERVICES_GRAPHS"
    else
        services-handle disable "$SERVICES_GRAPHS"
    fi

    if false; then
        SERVICES_PROMG="prometheus prometheus-node-exporter prometheus-dump1090-exporter grafana-server"
        if [[ -z ${PROMG} ]] || [[ ${PROMG} == "yes" ]]; then
            services-handle enable "$SERVICES_PROMG"
        else
            services-handle disable "$SERVICES_PROMG"
        fi
    fi
fi


# Runs a script that may be manually placed on /boot for batch setup.  By default, nothing there.
if [[ -f /boot/firstboot.sh ]]; then
    bash /boot/firstboot.sh
fi
